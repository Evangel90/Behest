{
  "name": "@behest/relayer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Behest gas relayer: pays NEAR gas for NEP-366 meta-transactions that call allowlisted, non-payable Behest methods.",
  "exports": {
    "./policy": "./src/policy.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "start": "tsx --env-file=../../.env src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "borsh": "2.0.0",
    "near-api-js": "7.4.0",
    "@noble/curves": "2.2.0",
    "@noble/hashes": "2.2.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
