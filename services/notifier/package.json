{
  "name": "@behest/notifier",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Behest notifier: watches plans (read-only) and delivers reminders and lifecycle notices per person by email, Telegram and signed webhooks.",
  "scripts": {
    "start": "tsx --env-file=../../.env src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@noble/hashes": "2.2.0",
    "@scure/base": "2.2.0",
    "near-api-js": "7.4.0",
    "nodemailer": "10.2.1",
    "viem": "2.57.16"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
