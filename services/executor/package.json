{
  "name": "@behest/executor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Replaceable Behest executor: broadcasts contract-signed Sepolia transfers and reports status.",
  "scripts": {
    "start": "tsx --env-file=../../.env src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "vault": "tsx --env-file-if-exists=../../.env src/vault.ts"
  },
  "dependencies": {
    "@ethereumjs/rlp": "5.0.2",
    "@ethereumjs/trie": "6.2.1",
    "@ethereumjs/util": "9.1.0",
    "@scure/base": "2.2.0",
    "@scure/btc-signer": "2.4.1",
    "near-api-js": "7.4.0",
    "viem": "2.57.16"
  },
  "devDependencies": {
    "@noble/curves": "2.2.0",
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "exports": {
    "./engine": "./src/engine.ts",
    "./near": "./src/near.ts",
    "./eth": "./src/eth.ts",
    "./store": "./src/store.ts",
    "./bitcoin": "./src/bitcoin.ts"
  }
}
