# Copy to .env and fill in. See README "Testnet deployment".
SEPOLIA_FUNDER_KEY=
SEPOLIA_RPC_URL=
# Node for revert/success proofs (D22): needs eth_getRawTransactionByBlockNumberAndIndex
# and eth_getBlockReceipts. Defaults to publicnode.
# SEPOLIA_PROOF_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
NEAR_RPC_URL=https://test.rpc.fastnear.com
MPC_CONTRACT_ID=v1.signer-prod.testnet
BEHEST_CONTRACT_ID=
ADMIN_ACCOUNT_ID=
EXECUTOR_ACCOUNT_ID=
EXECUTOR_PRIVATE_KEY=

# Gas relayer (services/relayer): a funded NEAR account that pays sponsored gas
RELAYER_ACCOUNT_ID=
RELAYER_PRIVATE_KEY=
RELAYER_URL=http://localhost:8787
# RELAYER_PORT=8787
# RELAYER_ALLOWED_ORIGIN=*
# RELAYER_PER_SENDER_PER_HOUR=30
# RELAYER_GLOBAL_PER_DAY=2000

# Web app "Try as…" personas (testnet only): a funded NEAR account that creates demo accounts
DEMO_FUNDER_ACCOUNT_ID=
DEMO_FUNDER_PRIVATE_KEY=
# NEXT_PUBLIC_NEAR_AUTH_CLIENT_ID=   # enables email/social/passkey sign-in once NEAR issues one
# PUBLIC_SEPOLIA_RPC_URL=            # browser-safe Sepolia RPC (defaults to publicnode)

# Notifier (services/notifier): per-person notices by email, Telegram and webhooks.
# See README "Notifications". Contacts live only in the notifier's database.
# NOTIFY_PORT=8790
# NOTIFY_PUBLIC_URL=http://localhost:8790        # public URL of the notifier (confirm/unsubscribe links)
# NOTIFY_APP_URL=http://localhost:3000           # web app (plan and settings links in messages)
# NOTIFY_ALLOWED_ORIGINS=http://localhost:3000   # comma-separated web origins allowed to call the API
# NOTIFY_DB=.notifier.db
# NOTIFY_SIGN_RECIPIENT=behest-notifier          # NEP-413 recipient; same as the web app's NEXT_PUBLIC_NOTIFY_RECIPIENT
# NOTIFY_TRUST_PROXY=                            # 1 behind a reverse proxy (rate limits use X-Forwarded-For)
# NOTIFY_INTERVAL_MS=30000
# NOTIFY_MAX_ATTEMPTS=8
# NOTIFY_RETRY_BASE_MS=30000
# NOTIFY_OWNERS=kemi.testnet,other.testnet       # extra plans to watch (operator)
# NOTIFY_WEBHOOK_URL=                            # operator feed: every notice
# NOTIFY_WEBHOOK_SECRET=                         # signs the operator feed (optional)
# NOTIFY_WEBHOOK_ALLOW_INSECURE=                 # 1 = allow http:// and private webhook hosts (local dev only)
# Email: any SMTP provider. Either SMTP_URL (smtps://user:pass@host:465) or host/port/user/pass.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=                                   # 1 for implicit TLS (port 465); 587 uses STARTTLS
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Behest <notify@example.com>"
# Telegram: a bot from @BotFather
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=                         # without the @
# Web app → notifier
# NEXT_PUBLIC_NOTIFIER_URL=http://localhost:8790
