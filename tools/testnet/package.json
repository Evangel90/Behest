    "e2e-intents": "tsx --env-file=../../.env src/intents-scenario.ts",
    "e2e-recovery": "tsx --env-file=../../.env src/recovery-scenario.ts"
  },
  "dependencies": {
    "@behest/executor": "workspace:*",
    "@behest/relayer": "workspace:*",
    "@noble/curves": "2.2.0",
    "@noble/hashes": "2.2.0",
    "@scure/base": "2.2.0",
    "@scure/btc-signer": "2.4.1",
    "near-api-js": "7.4.0",
    "viem": "2.57.16"
