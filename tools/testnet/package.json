{
  "name": "@behest/testnet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Testnet deployment and end-to-end demo scripts for Behest.",
  "scripts": {
    "deploy-contract": "tsx --env-file=../../.env src/deploy.ts",
    "typecheck": "tsc --noEmit",
    "e2e": "tsx --env-file=../../.env src/scenarios.ts",
    "e2e-eth": "tsx --env-file=../../.env src/eth-scenario.ts",
    "reissue": "tsx --env-file=../../.env src/reissue.ts",
    "bootstrap": "tsx --env-file=../../.env src/bootstrap.ts",
    "e2e-partial": "tsx --env-file=../../.env src/partial-scenario.ts",
    "btc-funder": "tsx --env-file=../../.env src/btc-funder.ts",
    "e2e-auto": "tsx --env-file=../../.env src/auto-scenario.ts",
    "e2e-rules": "tsx --env-file=../../.env src/rules-scenario.ts",
    "e2e-nep141": "tsx --env-file=../../.env src/nep141-scenario.ts",
    "e2e-btc": "tsx --env-file=../../.env src/btc-scenario.ts",
    "e2e-followup": "tsx --env-file=../../.env src/followup-scenario.ts",
    "e2e-revert": "tsx --env-file=../../.env src/revert-scenario.ts",
